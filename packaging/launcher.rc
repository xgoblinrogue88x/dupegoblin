#include <windows.h>
1 ICON "../app/Dupe Goblin.ico"
1 RT_MANIFEST "launcher.manifest"
1 VERSIONINFO
FILEVERSION 1,0,18,0
PRODUCTVERSION 1,0,18,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Dupe Goblin"
      VALUE "FileDescription", "Dupe Goblin duplicate file scanner"
      VALUE "FileVersion", "1.0.18"
      VALUE "InternalName", "DupeGoblin"
      VALUE "OriginalFilename", "Dupe Goblin.exe"
      VALUE "ProductName", "Dupe Goblin"
      VALUE "ProductVersion", "1.0.18"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
